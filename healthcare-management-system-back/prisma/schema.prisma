// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  Patient
  Pharmacy
  Admin
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PrescriptionItemStatus {
  PENDING
  ACCEPTED
  REJECTED
  BACKORDERED
}

enum NotificationType {
  PRESCRIPTION_UPDATED
  APPOINTMENT_REMINDER
  STATUS_CHANGED
}

/// Usuarios genéricos
model User {
  id            Int               @id @default(autoincrement())
  username      String            @unique
  email         String            @unique
  password      String
  role          UserRole
  phone         String?
  patient       Patient?
  pharmacy      Pharmacy?
  notifications Notification[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

/// Datos adicionales para pacientes
model Patient {
  id             Int       @id @default(autoincrement())
  dob            DateTime
  address        String
  userId         Int       @unique
  user           User      @relation(fields: [userId], references: [id])
  prescriptions  Prescription[]
  appointments   Appointment[]   @relation("PatientAppointments")

}

/// Datos adicionales para farmacias
model Pharmacy {
  id           Int         @id @default(autoincrement())
  address      String
  lat          Float
  lng          Float
  userId       Int         @unique
  user         User        @relation(fields: [userId], references: [id])
  inventory    Inventory[]
  appointments Appointment[] @relation("PharmacyAppointments")
  prescriptions Prescription[]
}

/// Catálogo de medicamentos
model Medication {
  id          Int                   @id @default(autoincrement())
  name        String
  description String?
  inventory   Inventory[]
  items       PrescriptionItem[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
}

/// Inventario de cada farmacia para cada medicamento
model Inventory {
  id           Int        @id @default(autoincrement())
  pharmacy     Pharmacy   @relation(fields: [pharmacyId], references: [id])
  pharmacyId   Int
  medication   Medication @relation(fields: [medicationId], references: [id])
  medicationId Int
  quantity     Int        @default(0)
  updatedAt    DateTime   @updatedAt

  @@unique([pharmacyId, medicationId])
}

/// Prescripciones subidas por pacientes
model Prescription {
  id          Int                 @id @default(autoincrement())
  patient     Patient             @relation(fields: [patientId], references: [id])
  patientId   Int
  fileUrl     String
  createdAt   DateTime            @default(now())
  appointments  Appointment[]       @relation("PrescriptionAppointments")
  items       PrescriptionItem[]
  pharmacy    Pharmacy            @relation(fields: [pharmacyId], references: [id])
  pharmacyId  Int
}

/// Ítems de cada prescripción (medicamentos solicitados)
model PrescriptionItem {
  id              Int                    @id @default(autoincrement())
  prescription    Prescription           @relation(fields: [prescriptionId], references: [id])
  prescriptionId  Int
  medication      Medication             @relation(fields: [medicationId], references: [id])
  medicationId    Int
  quantity        Int
  status          PrescriptionItemStatus @default(PENDING)
}

/// Citas para recogida de medicamentos
model Appointment {
  id          Int               @id @default(autoincrement())
  patient     Patient           @relation("PatientAppointments", fields: [patientId], references: [id])
  patientId   Int
  pharmacy    Pharmacy          @relation("PharmacyAppointments", fields: [pharmacyId], references: [id])
  pharmacyId  Int
  date        DateTime
  status      AppointmentStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  prescription    Prescription?      @relation("PrescriptionAppointments", fields: [prescriptionId], references: [id])
  prescriptionId  Int?
}

/// Notificaciones enviadas a usuarios
model Notification {
  id         Int              @id @default(autoincrement())
  user       User             @relation(fields: [userId], references: [id])
  userId     Int
  type       NotificationType
  message    String
  read       Boolean          @default(false)
  createdAt  DateTime         @default(now())
}
